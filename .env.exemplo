# Configuração de produção. Copie para .env (que fica fora do Git), preencha e proteja: chmod 600 .env
# Uso: docker run ... --env-file .env finder-fee   (ver docs/IMPLANTACAO.md)

# ---- obrigatórias
# Chave que assina o cookie de sessão. 32+ caracteres aleatórios; gere com:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
# Trocar a chave desconecta todo mundo.
FF_SECRET_KEY=
# Endereço público, usado nos links de convite e nos e-mails.
FF_PUBLIC_URL=https://portal.exemplo.com.br
# Banco PostgreSQL.
FF_DATABASE_URL=postgresql+psycopg://finder:SENHA@localhost:5432/finder_fee
# Número de proxies reversos na frente do app (nginx = 1). Não use sem proxy: o IP poderia ser forjado.
FF_TRUSTED_PROXIES=1
# Exige verificação em duas etapas da equipe interna.
FF_REQUIRE_2FA=1

# ---- e-mail (opcional; sem SMTP os avisos ficam só no portal)
# Antes de ligar pela primeira vez: docker exec finder-fee flask email-backlog
FF_SMTP_HOST=
FF_SMTP_PORT=587
FF_SMTP_USER=
FF_SMTP_PASS=
FF_MAIL_FROM=programa@exemplo.com.br
# starttls (587) | ssl (465) | none (só relay local). Vazio: escolhe pela porta.
FF_SMTP_SECURITY=
# Aviso mais antigo que isso (dias) não sai por e-mail; continua visível no portal.
FF_EMAIL_MAX_AGE_DAYS=7

# Endereço em que o app escuta. Com --network host, 127.0.0.1:8000 deixa só o nginx alcançá-lo.
FF_BIND=127.0.0.1:8000

# ---- ajustes (os valores abaixo são os padrões)
# Processos do gunicorn. Regra prática: 2 × núcleos da máquina.
FF_WORKERS=2
FF_SESSION_IDLE_MINUTES=120
FF_SESSION_MAX_HOURS=12
FF_IP_MAX_FAILURES=20
FF_IP_WINDOW_MINUTES=15
